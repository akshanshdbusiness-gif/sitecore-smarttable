{
  "name": "sitecore-quicktable",
  "version": "0.1.0",
  "description": "Installs the QuickTable table component (Sitecore templates, rendering and React component) into a SitecoreAI project.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "quicktable": "./bin/quicktable.js"
  },
  "files": [
    "bin",
    "src",
    "payload",
    "tools/ids.json"
  ],
  "exports": {
    ".": "./src/detect.js",
    "./ids": "./tools/ids.json",
    "./clipboard": "./payload/shared/clipboard.ts",
    "./payload/*": "./payload/*"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node tools/gen-items.mjs",
    "test": "node --test payload/shared/clipboard.test.ts"
  },
  "keywords": [
    "sitecore",
    "xm-cloud",
    "content-sdk",
    "table"
  ]
}
